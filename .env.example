# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# No value in this file is a working secret - every one of them is a placeholder.
# ---------------------------------------------------------------------------

# --- PostgreSQL (superuser, used only by the container entrypoint) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=postgres

# --- Per-service PostgreSQL databases and users -----------------------------
# All three databases are created on the FIRST start of the postgres volume,
# even though only auth_db is used in Phase 1. Creating them now avoids having
# to run `docker compose down -v` (which destroys data) in a later phase.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth-db

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change-me-inventory-db

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change-me-order-db

# --- MongoDB ----------------------------------------------------------------
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=change-me-mongo-root
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me-catalog-db

# --- JWT signing (RS256) ----------------------------------------------------
# Leave BOTH keys empty to let auth-service generate an ephemeral key pair at
# startup: convenient for a first `docker compose up`, but every restart
# invalidates previously issued tokens. NEVER leave them empty outside dev.
#
# Generate a real pair, then paste the single-line base64 values below:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem   # on macOS: base64 -i private.pem
#   base64 -w0 public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=logistics-auth-key
JWT_ISSUER=logistics-auth
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --- Technical account used by order-service for service-to-service calls ---
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-client-secret

# --- First administrator, created at startup only if it does not exist ------
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@logistics.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- Inventory ---
# How long a stock reservation is held before the sweeper releases it. Long enough
# for order-service to confirm, short enough that a crash does not strand stock.
RESERVATION_TTL=PT5M

# --- Orders / allocation engine ---
# Which allocation rule applies when a request expresses no preference.
#   nearest         - ships from the closest warehouses, splitting if needed
#   single-shipment - prefers one warehouse for the whole order, even if farther
ALLOCATION_DEFAULT_STRATEGY=nearest
RESERVATION_TTL_SECONDS=300

# --- Gateway ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200
