# ---------------------------------------------------------------------------
# Copiez ce fichier vers `.env` et renseignez les vraies valeurs. `.env` est ignoré par Git.
# Aucune valeur de ce fichier n'est un secret exploitable : ce sont tous des marqueurs.
# ---------------------------------------------------------------------------

# --- PostgreSQL (superutilisateur, utilisé uniquement par l'entrypoint du conteneur) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=postgres

# --- Bases et utilisateurs PostgreSQL, un par service -----------------------
# Les trois bases sont créées au PREMIER démarrage du volume postgres, même si
# seule auth_db sert en Phase 1. Les créer dès maintenant évite d'avoir à lancer
# `docker compose down -v` (qui détruit les données) lors d'une phase ultérieure.
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth-db

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change-me-inventory-db

ORDER_DB_NAME=order_db
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=change-me-order-db

# --- MongoDB ----------------------------------------------------------------
MONGO_ROOT_USER=mongoadmin
MONGO_ROOT_PASSWORD=change-me-mongo-root
CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=change-me-catalog-db

# --- Signature des JWT (RS256) ----------------------------------------------
# Laissez les DEUX clés vides pour qu'auth-service génère une paire éphémère au
# démarrage : pratique pour un premier `docker compose up`, mais chaque redémarrage
# invalide les jetons déjà émis. Ne les laissez JAMAIS vides hors développement.
#
# Générez une vraie paire, puis collez ci-dessous les valeurs base64 sur une ligne :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem   # sous macOS : base64 -i private.pem
#   base64 -w0 public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=logistics-auth-key
JWT_ISSUER=logistics-auth
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# --- Compte technique utilisé par order-service pour les appels entre services ---
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-client-secret

# --- Premier administrateur, créé au démarrage seulement s'il n'existe pas ---
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@logistics.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# --- Inventaire ---
# Durée pendant laquelle une réservation de stock est tenue avant que la tâche de
# nettoyage ne la libère. Assez longue pour qu'order-service confirme, assez courte
# pour qu'un plantage n'immobilise pas le stock.
RESERVATION_TTL=PT5M

# --- Commandes / moteur d'affectation ---
# Règle d'affectation appliquée lorsqu'une requête n'exprime aucune préférence.
#   nearest         - expédie depuis les entrepôts les plus proches, en fractionnant si besoin
#   single-shipment - privilégie un entrepôt unique pour toute la commande, même plus loin
ALLOCATION_DEFAULT_STRATEGY=nearest
RESERVATION_TTL_SECONDS=300

# --- Gateway ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200
